# Produced from 'fhicl-dump' using:
#   Input  : standard_detsim_sbnd.fcl
#   Policy : cet::filepath_maker
#   Path   : "FHICL_FILE_PATH"

outputs: {
   out1: {
      compressionLevel: 1
      dataTier: "simulated"
      fileName: "%ifb_%p-%tc.root"
      module_type: "RootOutput"
      outputCommands: [
         "keep *_*_*_*",
         "drop sim::OpDetBacktrackerRecords_*_*_*",
         "drop sim::SimPhotons_*_*_*",
         "drop sim::SimEnergyDeposits_ionandscintout__*",
         "drop sim::SimEnergyDeposits_ionandscint_*_*",
         "drop sim::SimEnergyDeposits_largeant_*_*",
         "keep sim::SimEnergyDeposits_ionandscint_priorSCE_*",
         "drop raw::OpDetWaveforms_opdaq_*_*"
      ]
      saveMemoryObjectThreshold: 0
   }
}
physics: {
   end_paths: [
      "stream1"
   ]
   producers: {
      rns: {
         module_type: "RandomNumberSaver"
      }
      simtpc2d: {
         module_type: "WireCellToolkit"
         wcls_main: {
            apps: [
               "TbbFlow"
            ]
            configs: [
               "pgrapher/experiment/sbnd/wcls-sim-drift-depoflux-nf-sp.jsonnet"
            ]
            inputers: [
               "wclsSimDepoSetSource:"
            ]
            outputers: [
               "wclsDepoFluxWriter:postdrift",
               "wclsFrameSaver:spsaver",
               "wclsFrameSaver:dnnsaver"
            ]
            params: {
               dnnroi_model_p0: "DNN_ROI/plane0.ts"
               dnnroi_model_p1: "DNN_ROI/plane1.ts"
               epoch: "perfect"
               inputTag: "ionandscint:priorSCE"
               reality: "sim"
               roi: "both"
               save_simdigits: "false"
               save_track_id: "true"
               signal_output_form: "sparse"
               wc_device: "cpu"
            }
            plugins: [
               "WireCellGen",
               "WireCellSigProc",
               "WireCellRoot",
               "WireCellPgraph",
               "WireCellLarsoft",
               "WireCellTbb",
               "WireCellPytorch"
            ]
            structs: {
               DL: 4
               DT: 8.8
               driftSpeed: 1.563
               enableLowROIThresholds: true
               lifetime: 35
               nchunks: 2
               nticks: 3427
               tick0_time: -205
               tick_per_slice: 4
            }
            tool_type: "WCLS"
         }
      }
   }
   simulate: [
      "rns",
      "simtpc2d"
   ]
   stream1: [
      "out1"
   ]
}
