         fileName: "opDetDigitizerRes.root"
      }
      TotalCAENBoards: 8
      service_type: "TriggerEmulationService"
   }
   WireReadout: {
      SortingParameters: {
         tool_type: "WireReadoutSorterSBND"
      }
      service_provider: "StandardWireReadout"
   }
   message: {
      destinations: {
         LogErrorFile: {
            append: false
            categories: {
               ParticleListActionService: {
                  limit: 0
               }
               SimDriftElectrons: {
                  limit: 0
               }
               default: {}
}
            filename: "errors.log"
            threshold: "ERROR"
            type: "file"
}
         LogInfoFile: {
            append: false
            categories: {
               default: {}
}
            filename: "messages.log"
            threshold: "INFO"
            type: "file"
}
         LogStandardOut: {
            categories: {
               GeometryBadInputPoint: {
                  limit: 5
                  timespan: 1000
               }
               ParticleListActionService: {
                  limit: 0
               }
               SimDriftElectrons: {
                  limit: 0
               }
               default: {}
}
            threshold: "WARNING"
            type: "cout"
}
}
}
   scheduler: {
      defaultExceptions: false
   }
}
source: {
   module_type: "RootInput"
}
