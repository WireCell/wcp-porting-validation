
#include "simulationservices_sbnd.fcl"
#include "messages_sbnd.fcl"
#include "detsim_drops.fcl"
#include "opdetdigitizer_sbnd.fcl"

# Imaging + clustering + Q/L matching using Xin's canonical WCT-native matching
# (FlashTensorToOpticalPCs + QLMatching) instead of the old larwirecell
# wclsQLMatching.  Same artROOT inputs as wcls-img-clus-matching.fcl; only the
# config jsonnet and the extra WireCellAux/WireCellMatch plugins differ.
#
# Run inside the SL7 container after `source sbnd/setup-ap.sh`:
#   time lar --nskip 0 -n 1 -c wcls-img-clus-matching-xin.fcl \
#       -s standalone-sample/2025f-mc.root --no-output >& wcls-img-clus-matching-xin.log

process_name: wclssig2img

services:
{
  TFileService: { fileName: "tf-default.root" }
  @table::sbnd_detsim_services
  # FileCatalogMetadata: @local::sbnd_file_catalog_mc
  AuxDetGeometry: @local::sbnd_auxdetgeo
  @table::sbnd_geometry_services
}


source: {
   module_type: RootInput
   #saveMemoryObjectThreshold: 10485760 //commented Ewerton 2024-07-08

   #inputCommands: ["drop *", "keep raw::RawDigits_*_*_*"]
   #inputCommands: ["drop *", "keep *_*_*_Swizzler"]
}

physics :{
   producers: {

      sig2img : {
         module_type : WireCellToolkit
         wcls_main: {
            tool_type: WCLS
            apps: ["Pgrapher"]

            logsinks: ["stdout"]
            loglevels: ["debug"]

            # WireCellAux: FlashTensorToOpticalPCs; WireCellMatch: QLMatching.
            # WireCellAIML: wclsTensorSetLabeler (truth labeling, MC only).
            plugins: ["WireCellGen", "WireCellImg", "WireCellClus", "WireCellPgraph", "WireCellSio", "WireCellRoot", "WireCellLarsoft", "WireCellAux", "WireCellMatch", "WireCellAIML"]

            # wclsTensorSetLabeler reads MCTruth/MCParticle/SimEnergyDeposit from
            # the art event.  TWO instances (docs/5-pr-chain-in-1step sec 6.7):
            # labeler_truth runs BEFORE the PR node and owns the truth
            # association; labeler_tagger runs AFTER it and emits only the
            # tagger verdict Bee sets.  Both must be listed here -- each needs
            # its own visit(art::Event&) to see run/subrun/event.
            inputers: [
                "wclsCookedFrameSource:sigs"
                , "wclsOpFlashSource:tpc0"
                , "wclsOpFlashSource:tpc1"
                , "wclsTensorSetLabeler:labeler_truth"
                , "wclsTensorSetLabeler:labeler_tagger"
                # RSE metadata attachers.  Each MUST be listed here or its
                # visit(art::Event&) never fires and it passes tensors through
                # with no RSE (it warns).  One per MultiAlgBlobClustering whose
                # run/subrun/event must be correct.
                , "wclsTensorSetMetadataAttacher:rse_apa0"
                , "wclsTensorSetMetadataAttacher:rse_apa1"
                , "wclsTensorSetMetadataAttacher:rse_all_apa"
                      ]

            # outputers: ["wclsNumpyFrameSaver:signal"]

            configs: ["wcls-img-clus-matching-xin.jsonnet"]

            params : {
                # Set "data" vs. "sim".
                reality: "sim"
                # Image configuration
                img_config: "active2view+masked2view"
                # "false" drops tracking_visitor + tagger_output, i.e. no
                # tracking-pr.root.  REQUIRED when running >1 event per lar
                # process: both writers share one filename (RECREATE + UPDATE)
                # and multi-event silently corrupts it.  Costs you T_tagger /
                # T_kine, hence numu_score / nue_score / kine_reco_Enu; the Bee
                # "mc" node keeps Enu and both scores regardless.
                enable_tracking_root: "true"
                # PR operating point.  "sync" (default) passes the ~151 knobs
                # Xin's 2-step wct-pr-perevt.jsonnet sets, via the generated
                # pr-operating-point.jsonnet, so this chain reconstructs at the
                # SBND production operating point.  "preflip" reproduces the
                # pre-2026-08-29 behaviour that issue-16 (MC) and issue-18 (data)
                # were run with -- keep it to regenerate those campaigns.
                # Gate: issues/17-.../scripts/compile-both.sh must exit 0.
                pr_operating_point: "sync"
                opflash0_input_label: "opflashtpc0:"
                opflash1_input_label: "opflashtpc1:"
            }
            structs : {
                # data/moon
                # recobwire_tags: "[\"sptpc2d:gauss\", \"sptpc2d:wiener\"]"
                # trace_tags: "[\"gauss\", \"wiener\"]"
                # summary_tags: "[\"\", \"sptpc2d:wienersummary\"]"
                # input_mask_tags: "[\"sptpc2d:badmasks\"]"
                # output_mask_tags: "[\"bad\"]"
                # sim
                recobwire_tags: "[\"simtpc2d:dnnsp\", \"simtpc2d:dnnsp\"]"
                # recobwire_tags: "[\"simtpc2d:gauss\", \"simtpc2d:wiener\"]"
                trace_tags: "[\"gauss\", \"wiener\"]"
                summary_tags: "[\"\", \"simtpc2d:wienersummary\"]"
                input_mask_tags: "[\"simtpc2d:badmasks\"]"
                output_mask_tags: "[\"bad\"]"
            }
         }
      }
   }

   p1 : [ sig2img ]
   trigger_paths : [ p1 ]

}
