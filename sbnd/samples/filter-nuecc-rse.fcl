# Runnable fcl for the ported larwirecell FilterEventID module.
# Based verbatim on sbndcode feature/lynnt_evtfilter Commissioning/fcls/filtereventid.fcl;
# only filterruns/filterevts are filled here (paired: filterruns[i] <-> filterevts[i]),
# generated from lynn-nuecc-rse.csv (48 nuecc candidate events).

process_name: FilterEventID

services: {}

source:
{
  module_type: RootInput
  maxEvents:  -1
}

outputs:
{
 out1:
 {
   module_type: RootOutput
   fileName:    "%ifb_eventidfiltered.root"
   dataTier:    "filtered"
   SelectEvents: [ filter ]
 }
}

physics:
{
  filters:
  {
    filtereventid: {
      module_type: FilterEventID
      # filterruns[i] must correspond to filterevts[i]
      filterevts: [ 69314, 433451, 90055, 196649, 172230, 219295, 122660, 239794, 388, 138009, 268784, 269774, 422851, 46363, 74544, 444187, 137238, 38856, 30504, 256587, 10550, 360535, 235435, 389538, 116962, 234638, 342199, 214469, 81597, 400474, 267597, 246579, 469665, 42280, 423981, 437699, 489330, 163543, 131357, 447477, 111412, 350186, 52672, 54095, 268067, 271851, 168596, 174637 ]
      filterruns: [ 18255, 18255, 18255, 18255, 18253, 18255, 18255, 18255, 18255, 18255, 18255, 18255, 18255, 18255, 18259, 18253, 18264, 18304, 18342, 18306, 18255, 18255, 18255, 18255, 18259, 18255, 18269, 18409, 18313, 18355, 18279, 18255, 18255, 18259, 18255, 18255, 18255, 18255, 18259, 18255, 18259, 18255, 18259, 18259, 18255, 18255, 18255, 18255 ]
    }
  }

  filter: [ filtereventid ]
  stream1:  [ out1 ]
  trigger_paths: [ filter ]
  end_paths:     [ stream1 ]
}
