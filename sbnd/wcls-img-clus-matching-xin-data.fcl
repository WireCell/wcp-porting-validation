# Real-data variant of wcls-img-clus-matching-xin.fcl.
# Overrides reality + the recob::Wire / summary / badmask product tags to the
# data (sptpc2d) instances; everything else (graph, opflash labels, img_config)
# is inherited.  reality="data" selects the grouped reco config in the toolkit
# clus maker: use_sce=false (T0-corrected reco scope) + pos_offset_on=true
# (per-TPC calibration).  The labeler runs in data mode (RSE + input-only HDF5).
#
# Run inside the SL7 container after `source sbnd/setup-ap.sh`, from sbnd/ with
# this dir on FHICL_FILE_PATH:
#   export FHICL_FILE_PATH=$PWD:$FHICL_FILE_PATH
#   lar -n 100 -S <data_paths.lst> -c wcls-img-clus-matching-xin-data.fcl --no-output

#include "wcls-img-clus-matching-xin.fcl"

physics.producers.sig2img.wcls_main.params.reality: "data"
physics.producers.sig2img.wcls_main.structs.recobwire_tags:  "[\"sptpc2d:dnnsp\", \"sptpc2d:dnnsp\"]"
physics.producers.sig2img.wcls_main.structs.summary_tags:    "[\"\", \"sptpc2d:wienersummary\"]"
physics.producers.sig2img.wcls_main.structs.input_mask_tags: "[\"sptpc2d:badmasks\"]"

# Data keeps BOTH wclsTensorSetLabeler inputers: in data mode each reads only
# run/subrun/event from the art::Event (no MCTruth/MCParticle/SimEnergyDeposit).
# The jsonnet passes reality="data", which gates every truth output off, so
# labeler_truth contributes just the input-only nugraph HDF5 and labeler_tagger
# contributes the tagger verdict Bee sets (those are emitted in BOTH realities).
# labeler_tagger also carries label_blobs=false, which in data mode is what stops
# it stamping trackid=-1 over labeler_truth's per-blob labels.
# (Inherited from the sim fcl -- listed here only for clarity.)
physics.producers.sig2img.wcls_main.inputers: [
    "wclsCookedFrameSource:sigs"
    , "wclsOpFlashSource:tpc0"
    , "wclsOpFlashSource:tpc1"
    , "wclsTensorSetLabeler:labeler_truth"
    , "wclsTensorSetLabeler:labeler_tagger"
    # RSE metadata attachers -- see the sim fcl.  Reality-independent: they read
    # only run/subrun/event, so data gets correct RSE exactly as sim does.
    , "wclsTensorSetMetadataAttacher:rse_apa0"
    , "wclsTensorSetMetadataAttacher:rse_apa1"
    , "wclsTensorSetMetadataAttacher:rse_all_apa"
]
