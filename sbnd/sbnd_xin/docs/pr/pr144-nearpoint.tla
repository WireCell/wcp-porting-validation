# doc sbnd_xin/pr/144 sec 13.2 -- the pr/129 pointing test offered to the
# near-cross-cluster kine pool.  Thresholds mirror pr/129's SBND production
# values (kine_guard_freed_impact = 20 cm, kine_guard_freed_miss_deg = 30).
# Default is 0 = off = byte-identical; this file arms it.
kine_near_pointing_impact=20
kine_near_pointing_miss_deg=30
